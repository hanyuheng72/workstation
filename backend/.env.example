# ============================================================
# 个人工作台 —— 后端环境变量模板
#
# 复制为 .env 后填入真实值；.env 不会被提交，也不会进 Docker 镜像。
#
# 本地开发：直接跑 Spring Boot 时读这个文件。
# 云部署：不需要这个文件，把同样的变量直接配到平台的环境变量里即可
#        （Render 的 Environment 页签、Railway 的 Variables 等）。
# ============================================================

# ---- 数据库 ----
# 本机 MySQL：
DB_URL=jdbc:mysql://localhost:3306/workstation?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
#
# 云数据库（Aiven 等）必须走 SSL，把地址换成服务商给的主机名，
# 并保留 / 追加下面这几个参数：
#   sslMode=REQUIRED            强制加密连接
#   serverTimezone=Asia/Shanghai 避免时间差 8 小时
# 形如：
# DB_URL=jdbc:mysql://xxx.aivencloud.com:12345/workstation?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&sslMode=REQUIRED
DB_USERNAME=
DB_PASSWORD=

# ---- 登录 ----
# true = 需要登录；false = 打开即用。
# 公网部署务必保持 true：关掉之后，拿到网址的人就能读写你的全部数据。
APP_AUTH_ENABLED=true
APP_PASSWORD=
# 随便一段足够长的随机串（至少 32 字符）
JWT_SECRET=
# 令牌有效期（天）
JWT_EXPIRE_DAYS=30

# ---- DeepSeek ----
# 只在后端读取，任何接口与日志都不会输出它
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- CORS ----
# 逗号分隔。用浏览器直连后端时需要列出前端来源。
# 打包成 App 后 WebView 的来源是 null，需要把 null 也放进去（见下面一行）。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 端口 ----
# 云平台会自己注入 PORT，这里留空即可；本地开发默认 8080
# SERVER_PORT=8080
